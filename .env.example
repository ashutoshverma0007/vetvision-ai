# ==============================================================================
# VetVision AI Environment Variables (Template / Safe Example)
# ==============================================================================
# COPY THIS FILE TO .env FOR LOCAL DEVELOPMENT.
# NEVER COMMIT ACTUAL SECRETS, API KEYS, OR CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
APPLICATION_URL=http://localhost:5173
API_URL=http://localhost:4000

# Database (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vetvision_ai?schema=public

# Session & Security
# Generate secure 64-character random strings in production
SESSION_SECRET=dev-insecure-secret-replace-in-production-must-be-at-least-32-chars
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Object Storage (Local Development or S3-Compatible)
# STORAGE_PROVIDER options: local | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./data/storage
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=vetvision-assets
OBJECT_STORAGE_ACCESS_KEY=example_access_key
OBJECT_STORAGE_SECRET_KEY=example_secret_key
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Internal AI Service Configuration
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_INTERNAL_SECRET=dev-internal-ai-secret-key-32-bytes-long
AI_SERVICE_TIMEOUT_MS=15000
AI_MODEL_CONFIDENCE_THRESHOLD=0.65

# Email Provider Configuration
# EMAIL_PROVIDER options: console | smtp | sendgrid
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=noreply@vetvision.ai
EMAIL_FROM_NAME="VetVision AI"
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=example_smtp_user
SMTP_PASS=example_smtp_password
SMTP_SECURE=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ==============================================================================
# MSG91 Email OTP Service Configuration (Server-Side Only)
# Do NOT prefix with VITE_. Credentials must remain strictly private to backend.
# https://docs.msg91.com/otp
# ==============================================================================
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_msg91_email_template_id_here
MSG91_EMAIL_TEMPLATE_ID=your_msg91_email_template_id_here
MSG91_OTP_API_URL=https://control.msg91.com/api/v5/otp
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
